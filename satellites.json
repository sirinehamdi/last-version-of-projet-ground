{
  "esp32_serial": {
    "name": "ESP32 - Serie",
    "communication": {
      "type": "serial",
      "port": "COM7",
      "baudrate": 115200,
      "timeout": 1
    },
    "decoder": {
      "frame_delimiter": "~",
      "field_separator": "|",
      "param_separator": ",",
      "param_keyvalue_separator": ":",
      "frame_index": 1,
      "cmd_id_index": 2,
      "seq_index": 3,
      "length_index": 4,
      "data_index": 5,
      "checksum_index": 6,
      "checksum_value": "0",
      "telecommand_type": "TC",
      "telemetry_type": "TM",
      "ack_type": "ACK"
    },
    "camera_enabled": true,
    "image_save_dir": "static/img/esp32",
    "database_dir": "instance",
    "database_file": "data.db",
    "available_commands": [
      {"label": "Camera", "feature": "camera", "on_id": "CAM_ON", "off_id": "CAM_OFF"},
      {"id": "RESET", "label": "Reset"},
      {"id": "STATUS", "label": "Status"}
    ]
  },
  "esp32_wifi": {
    "name": "ESP32 - WiFi",
    "communication": {
      "type": "wifi",
      "host": "172.20.10.2",
      "port_wifi": 80,
      "timeout_wifi": 15
    },
    "decoder": {
      "frame_delimiter": "~",
      "field_separator": "|",
      "param_separator": ",",
      "param_keyvalue_separator": ":",
      "frame_index": 1,
      "cmd_id_index": 2,
      "seq_index": 3,
      "length_index": 4,
      "data_index": 5,
      "checksum_index": 6,
      "checksum_value": "0",
      "telecommand_type": "TC",
      "telemetry_type": "TM",
      "ack_type": "ACK"
    },
    "camera_enabled": true,
    "image_save_dir": "static/img/esp32",
    "database_dir": "instance",
    "database_file": "data.db",
    "available_commands": [
      {"label": "Camera", "feature": "camera", "on_id": "CAM_ON", "off_id": "CAM_OFF"},
      {"id": "RESET", "label": "Reset"},
      {"id": "STATUS", "label": "Status"}
    ]
  },
  "esp32_test": {
    "name": "Satellite Test Format 2",

    "communication": {
      "type": "serial",
      "port": "COM7",
      "baudrate": 115200,
      "timeout": 2
    },

    "decoder": {
      "frame_delimiter": "@",
      "field_separator": ";",
      "param_separator": "#",
      "param_keyvalue_separator": "=",

      "frame_index": 0,
      "cmd_id_index": 1,
      "seq_index": 2,
      "length_index": 3,
      "data_index": 4,
      "checksum_index": 5,
      "checksum_value": "77",
      "closing_frame_delimiter": true,

      "telecommand_type": "TC",
      "telemetry_type": "TM",
      "ack_type": "ACK"
    },

    "camera_enabled": true,

    "image_save_dir": "static/img/satellite_test",

    "database_dir": "instance",
    "database_file": "satellite_test.db",

    "available_commands": [
      {"label": "Camera", "feature": "camera", "on_id": "CAM_ON", "off_id": "CAM_OFF"},
      {"id": "RESET", "label": "Reset"},
      {"id": "STATUS", "label": "Status"}
    ]
  },
 "esp32_test_3": {
